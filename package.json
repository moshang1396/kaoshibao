{
  "name": "kaoshibao",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app:start": "electron .",
    "app:build": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.kaoshibao.app",
    "productName": "KaoShiBao",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "portable3"
    },
    "extraResources": [
      {
        "from": "public/icon-512.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "考试宝.exe"
    }
  },
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/cli": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "pinia": "^2.1.7",
    "vue": "^3.4.27",
    "vue-router": "^4.3.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "jimp": "^0.22.12",
    "playwright-core": "^1.65.1",
    "png-to-ico": "^3.0.2",
    "vite": "^5.2.11"
  }
}
